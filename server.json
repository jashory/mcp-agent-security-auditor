{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jashory/mcp-agent-security-auditor",
  "title": "MCP & Agent Security Auditor (MCP Server)",
  "description": "Stdio Model Context Protocol (MCP) server and zero-dependency Python AST security scanner for auditing MCP servers, AI agent hooks, and Firebase rules.",
  "version": "2.4.1",
  "websiteUrl": "https://jashory.github.io/mcp-agent-security-auditor/",
  "repository": {
    "url": "https://github.com/jashory/mcp-agent-security-auditor",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-agent-security-auditor",
      "version": "2.4.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "python",
      "packageArguments": [
        {
          "type": "named",
          "name": "--mcp"
        }
      ]
    }
  ]
}
